# Copy to backend/.env and fill values on the server. Never put these values in the APK.
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-backend.example.com
OAUTH_REDIRECT_URI=https://your-backend.example.com/oauth/google/callback
DATA_DIR=./data

# Google OAuth: preferred method is a Web application OAuth client.
# Download the client JSON from Google Cloud Console and place it on the server.
GOOGLE_OAUTH_CREDENTIALS=./credentials/google-oauth-web.json
# Alternatively:
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-web-client-secret

# Bearer key used by the Android app. If omitted, the backend creates data/app-api.key.
APP_API_KEY=
# 32-byte key encoded as base64/base64url or 64 hex characters. If omitted, a local key file is created.
TOKEN_ENCRYPTION_KEY=

# Keep writes disabled until read-only authorization and tests pass.
ENABLE_SHEET_WRITE=false
ENABLE_GMAIL_WRITE=false
APPROVAL_TTL_SECONDS=300

# Optional backend AI used only for summarize_business_replies.
# The Android app can still summarize returned real message text with its existing AI.
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=
# AI_BASE_URL=

DEBUG=false
